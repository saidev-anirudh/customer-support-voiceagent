# Copy to .env and fill in. Never commit the real file.
# The agent loads this file when run from agent/.

# --- LiveKit Cloud (https://cloud.livekit.io -> Settings -> API keys) ---------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Name used for explicit agent dispatch. Must match AGENT_NAME in web/.env.local.
AGENT_NAME=claims-support

# --- Speech and language models ----------------------------------------------
# Sarvam realtime speech-to-text (English, Hindi, and code-mixed speech)
SARVAM_API_KEY=

# Cartesia text-to-speech. Pick any multilingual Sonic voice id from the Cartesia library.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3

# LLM option 1: Azure OpenAI (used when AZURE_OPENAI_MAIN_API_KEY is set).
# BASE_URL is the v1 endpoint, ending in /openai/v1. BASE_MODEL is the deployment name.
# API_VERSION is informational: the v1 endpoint does not need an api-version parameter.
AZURE_OPENAI_MAIN_API_KEY=
AZURE_OPENAI_MAIN_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_MAIN_BASE_MODEL=gpt-4.1
AZURE_OPENAI_MAIN_API_VERSION=2025-04-14

# LLM option 2: OpenRouter (fallback when no Azure key is set; any tool-calling model)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# --- External system (Google Sheets) -----------------------------------------
# Spreadsheet id from its URL, shared with the service account email as Editor.
GOOGLE_SHEET_ID=
# Path to the service-account JSON key. On LiveKit Cloud this is mounted as a file secret.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
CUSTOMERS_TAB=Customers
INTERACTIONS_TAB=Interactions

# --- Branding ----------------------------------------------------------------
COMPANY_NAME=Northwind Insurance
